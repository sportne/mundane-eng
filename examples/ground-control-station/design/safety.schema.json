{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "context",
    "severityScale",
    "assumptions",
    "causes",
    "hazards",
    "controls",
    "failureModes",
    "faultTree",
    "reviewedAgainst"
  ],
  "properties": {
    "format": {
      "const": "mundane-safety-yaml-0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "configuration",
        "modes"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "$ref": "#/$defs/ref"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1
        }
      }
    },
    "severityScale": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "meaning"
        ],
        "properties": {
          "id": {
            "enum": [
              "minor",
              "major",
              "catastrophic"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "owner",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "unverified",
              "accepted-for-simulation"
            ]
          }
        }
      },
      "minItems": 1
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "commonCauseGroup"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "commonCauseGroup": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "causes",
          "consequence",
          "severity",
          "controls",
          "assumptions",
          "residualRisk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "causes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "minor",
              "major",
              "catastrophic"
            ]
          },
          "controls": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 0
          },
          "assumptions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "residualRisk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "owner",
              "reason"
            ],
            "properties": {
              "state": {
                "enum": [
                  "unresolved",
                  "review-required"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "hazards",
          "requirements",
          "obligations",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "hazards": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "obligations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "function",
          "mode",
          "effects",
          "causes",
          "detection",
          "mitigations",
          "assumptions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "component": {
            "$ref": "#/$defs/ref"
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "causes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "detection": {
            "$ref": "#/$defs/ref"
          },
          "mitigations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "faultTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "top",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "top": {
          "$ref": "#/$defs/ref"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operator",
              "inputs",
              "cause"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "operator": {
                "enum": [
                  "basic",
                  "and",
                  "or"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ref"
                },
                "minItems": 0
              },
              "cause": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/ref"
                  }
                ]
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "reviewedAgainst": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "sha256"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT safety YAML 0.1",
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "scope",
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
