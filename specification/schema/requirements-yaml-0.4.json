{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mundanereq:yaml:0.4",
  "title": "Mundane requirements YAML source 0.4",
  "type": "object",
  "required": [
    "format",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]",
            "not": {
              "pattern": "[^A-Za-z0-9._-]"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "allocation": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "statement": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "prose"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "prose": {
                          "type": "string",
                          "minLength": 1,
                          "not": {
                            "pattern": "[\\r\\n]"
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "math"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "math": {
                          "type": "object",
                          "required": [
                            "language",
                            "payload"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "language": {
                              "const": "latex"
                            },
                            "payload": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "[^\\n]"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "rationale": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                }
              }
            ]
          },
          "decomposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]",
              "not": {
                "pattern": "[^A-Za-z0-9._-]"
              }
            }
          },
          "attributes": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "allOf": [
                {
                  "not": {
                    "enum": [
                      "id",
                      "title",
                      "allocation",
                      "statement",
                      "rationale",
                      "source",
                      "decomposes",
                      "format",
                      "requirements",
                      "attributes",
                      "attribute-schema"
                    ]
                  }
                },
                {
                  "not": {
                    "pattern": "^(mreq-|mundane-)"
                  }
                }
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            }
          }
        }
      },
      "maxItems": 10000
    },
    "format": {
      "const": "mundanereq-yaml-0.4"
    },
    "attributeSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "attributeSchema"
          ]
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "items": {
              "not": {
                "required": [
                  "attributes"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
