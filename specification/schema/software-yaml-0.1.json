{
  "type": "object",
  "properties": {
    "format": {
      "const": "mundane-software-yaml-0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
        },
        "kind": {
          "const": "baseline"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
        }
      },
      "required": [
        "scope",
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "[0-9a-f]{64}"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "uri"
          ],
          "additionalProperties": false
        },
        "recipe": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "[0-9a-f]{64}"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "uri"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "sbom": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "binary",
        "source",
        "recipe",
        "provenance",
        "sbom"
      ],
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "no-scan",
            "failed"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[0-9a-f]{64}"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "tool",
        "version",
        "result"
      ],
      "additionalProperties": false
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "interface": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
              },
              "kind": {
                "const": "interface"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
              }
            },
            "required": [
              "scope",
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "interface",
          "description"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "boundary",
          "scenario"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "threat": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "requirement": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
              },
              "kind": {
                "const": "requirement"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
              }
            },
            "required": [
              "scope",
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "safetyControl": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
              },
              "kind": {
                "const": "control"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
              }
            },
            "required": [
              "scope",
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "threat",
          "requirement",
          "safetyControl",
          "mitigation"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "advisory": {
            "type": "string",
            "minLength": 1
          },
          "sbomSha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9a-f]{64}"
          },
          "scanSha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9a-f]{64}"
          },
          "configurationSha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9a-f]{64}"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "advisory",
          "sbomSha256",
          "scanSha256",
          "configurationSha256",
          "reviewer",
          "rationale"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1000
    }
  },
  "required": [
    "format",
    "id",
    "configuration",
    "build",
    "scan",
    "boundaries",
    "threats",
    "controls",
    "reviews",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software project selections and security relationships"
}
