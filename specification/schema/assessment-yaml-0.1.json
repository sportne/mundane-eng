{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "run",
    "disposition",
    "reviewer",
    "role",
    "reason"
  ],
  "properties": {
    "format": {
      "enum": [
        "mundane-assessment-yaml-0.1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "disposition": {
      "enum": [
        "adequate",
        "insufficient",
        "disputed"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assessment 0.1"
}
