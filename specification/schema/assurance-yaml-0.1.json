    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
